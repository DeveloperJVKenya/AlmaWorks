rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: the previous blanket `match /{document=**} { allow read, write: if
    // true; }` catch-all has been removed. Firestore evaluates all matching
    // rule blocks for a path as an OR, so as long as that catch-all existed,
    // no other rule in this file — including the strict InventoryAssets /
    // InventoryAssetAssignments rules below — could ever actually restrict
    // anything. Every collection the app uses now has its own explicit block
    // below (audited against the full lib/ source tree), so removing the
    // catch-all is a no-op for every existing feature and is required for
    // the new Inventory rules to mean anything.

    // Rules for Projects collection
    match /Projects/{projectId} {
      allow read, write: if true;
      
      // Allow access to subcollections
      match /tasks/{taskId} {
        allow read, write: if true;
      }
      
      match /activities/{activityId} {
        allow read, write: if true;
      }
      
      match /photos/{photoId} {
        allow read, write: if true;
      }
      
      match /Drawings/{drawingId} {
        allow read, write: if true;
      }
    }
    
    // Rules for Tasks collection
    match /Tasks/{taskId} {
      allow read, write: if true;
    }
    
    // Rules for Users collection
    match /Users/{userId} {
      allow read, write: if true;
    }
    
    // Rules for ClientRequests collection (NEW)
    match /ClientRequests/{requestId} {
      allow read, write: if true;
    }
    
    // Rules for ActivityItems collection
    match /ActivityItems/{activityId} {
      allow read, write: if true;
    }
    
    // Rules for Notifications collection
    match /Notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // Rules for Reports collection
    match /Reports/{reportId} {
      allow read, write: if true;
    }
    
    // Rules for Settings collection
    match /Settings/{settingId} {
      allow read, write: if true;
    }
    
    // Rules for Attendance collection
    match /Attendance/{attendanceId} {
      allow read, write: if true;
    }
    
    // Rules for Weather collection
    match /Weather/{weatherId} {
      allow read, write: if true;
    }
    
    // Rules for Financial collection
    match /Financials/{financialId} {
      allow read, write: if true;
    }
    
    // Rules for Schedule collection
    match /Schedule/{scheduleId} {
      allow read, write: if true;
    }
    
    // Rules for Resources collection
    match /Resources/{resourceId} {
      allow read, write: if true;
    }
    
    match /ScheduleNotifications/{notificationId} {
      allow read, write: if true;
    }
    
    // Rules for QualitySafety collection
    match /QualitySafety/{qualitySafetyId} {
      allow read, write: if true;
    }
    
    // Rules for BidManagement collection
    match /BidManagement/{bidId} {
      allow read, write: if true;
    }
    
    // Rules for DesignCoordination collection
    match /DesignCoordination/{designId} {
      allow read, write: if true;
    }
    
    // Rules for FieldProductivity collection
    match /FieldProductivity/{productivityId} {
      allow read, write: if true;
    }
    
    // Rules for RecentSearches collection
    match /RecentSearches/{searchId} {
      allow read, write: if true;
    }
    
    // Rules for UserProfiles collection
    match /UserProfiles/{userId} {
      allow read, write: if true;
    }
    
    // Rules for SystemLogs collection
    match /SystemLogs/{logId} {
      allow read, write: if true;
    }
    
    // Rules for PurchaseplanResources collection
    match /PurchaseplanResources/{resourceId} {
      allow read, write: if true;
    }
    
    // Rules for PhotoGallery collection (top-level)
    match /PhotoGallery/{photoId} {
      allow read, write: if true;
    }
    
    // Rules for ProjectDocuments collection (top-level)
    match /ProjectDocuments/{docId} {
      allow read, write: if true;
    }
    
    // Rules for QualityDocuments collection
    match /QualityDocuments/{docId} {
      allow read, write: if true;
    }
    
    // Rules for SafetyDocuments collection
    match /SafetyDocuments/{docId} {
      allow read, write: if true;
    }
    
    // Rules for Drawings collection
    match /Drawings/{drawingId} {
      allow read, write: if true;
    }
    
    // Rules for GeneralSchedules collection (NEW)
    match /GeneralSchedules/{scheduleId} {
      allow read, write: if true;
    }

    // ── Collections discovered in use but previously relying solely on the
    // top-level catch-all (audited prior to its removal, see below) ────────
    match /AdminNotificationQueue/{itemId} {
      allow read, write: if true;
    }

    // Targeted counterpart to AdminNotificationQueue (see
    // lib/rbacsystem/notification_service.dart's setupUserNotificationListener
    // and lib/services/inventory_service.dart's _notifyUser) — same
    // permissiveness as AdminNotificationQueue for consistency.
    match /UserNotificationQueue/{itemId} {
      allow read, write: if true;
    }

    // Messages are readable/writable only by their participants (sender +
    // To + Cc), tracked via the flat `participantUids` array kept in sync
    // with `from`/`to`/`cc` at send time (see CommunicationMessage in
    // communication_models.dart — rules can't reach into map fields nested
    // inside an array element, hence the separate flat uid list). Only
    // `readByUids`/`deletedByUids` may be mutated post-send (mark read/
    // unread, soft delete/restore) — everything else about a sent message
    // is immutable, and messages are never hard-deleted (soft delete only).
    match /Communication/{messageId} {
      allow read: if request.auth != null
                   && request.auth.uid in resource.data.participantUids;

      allow create: if request.auth != null
                     && request.resource.data.from.uid == request.auth.uid
                     && request.auth.uid in request.resource.data.participantUids;

      allow update: if request.auth != null
                     && request.auth.uid in resource.data.participantUids
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['readByUids', 'deletedByUids']);

      allow delete: if false;
    }

    // Drafts are private to the user who saved them.
    match /CommunicationDrafts/{draftId} {
      allow read, update, delete: if request.auth != null
                     && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.ownerUid;
    }

    match /ScheduleMonitor/{docId} {
      allow read, write: if true;
    }

    match /TaskProgressMonitor/{docId} {
      allow read, write: if true;
    }

    match /ClientAccessRequests/{requestId} {
      allow read, write: if true;
    }

    match /Photos/{photoId} {
      allow read, write: if true;
    }

    match /NotificationLocks/{lockId} {
      allow read, write: if true;
    }

    // Lowercase 'projects' — distinct from the capitalized 'Projects'
    // collection above; used by financial_screen.dart, documents_screen.dart,
    // and rbacsystem/client_request_service.dart.
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // ═══════════════════════════════════════════════════════════════════
    // INVENTORY MODULE (Phase 1: Assets + custody traceability)
    // These are the only collections in this file with real, enforced
    // role checks — everything above stays wide open to match the rest
    // of the (pre-auth, dev-mode) app.
    // ═══════════════════════════════════════════════════════════════════

    // uid -> role mirror. Users/{username} docs are keyed by username, not
    // uid, so rules can't get() a caller's role directly from Users; this
    // collection exists purely so inventoryUserRole() below can resolve it
    // with a single-document get().
    //
    // Self-healing sync, not a one-time write: the doc must carry a
    // 'username' field naming the caller's own Users/{username} doc, and the
    // write is only accepted if that Users doc's `uid` matches the caller AND
    // its `role` matches the value being written. A caller can therefore
    // never write a role they don't already hold in Users — they can only
    // mirror truth that already exists there, into a shape rules can look up
    // by uid. AuthService.ensureUserRoleMirror() calls this on every login
    // and at registration, so any account — new or pre-existing — self-heals
    // its mirror automatically the next time it signs in; no manual Admin SDK
    // backfill is required for accounts to stop being gated out of Inventory.
    function _usersDocForRoleMirror() {
      return get(/databases/$(database)/documents/Users/$(request.resource.data.username));
    }

    match /UserRoles/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                             && request.auth.uid == uid
                             && request.resource.data.keys().hasOnly(['role', 'username'])
                             && _usersDocForRoleMirror().data.uid == request.auth.uid
                             && _usersDocForRoleMirror().data.role == request.resource.data.role;

      allow delete: if false;
    }

    function inventoryUserRole() {
      return get(/databases/$(database)/documents/UserRoles/$(request.auth.uid)).data.role;
    }

    match /InventoryAssets/{assetId} {
      // Technician reads + requests checkouts (see InventoryCheckoutRequests
      // below) same as MainAdmin/Admin, but never registers new items and
      // never performs the custody-pointer update directly (see the
      // `update` block below) — that stays MainAdmin/Admin, whether direct
      // or via the approval transaction.
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      // MainAdmin/Admin may register new assets.
      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin']
                     && request.resource.data.createdByUid == request.auth.uid;

      // Three distinct, narrowly-scoped update paths:
      //  (a) MainAdmin/Admin correcting descriptive fields.
      //  (b) MainAdmin/Admin's checkout/return transaction updating only
      //      the custody-pointer fields (paired with a new, immutable
      //      InventoryAssetAssignments doc in the same transaction).
      //  (c) MainAdmin/Admin's booking mutation refreshing the denormalized
      //      "next upcoming booking" pointer (InventoryService._refreshNextBooking).
      allow update: if request.auth != null && (
        (inventoryUserRole() in ['MainAdmin', 'Admin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'category', 'description', 'serialNumber', 'photoUrl', 'updatedAt']))
        ||
        (inventoryUserRole() in ['MainAdmin', 'Admin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'currentHolderId', 'currentHolderName',
                      'currentProjectId', 'currentProjectName',
                      'currentAssignmentId', 'pendingRequestId', 'updatedAt']))
        ||
        (inventoryUserRole() in ['MainAdmin', 'Admin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nextBookingId', 'nextBookingStart', 'nextBookingEnd', 'nextBookingByName']))
        ||
        // The other half of InventoryService.createCheckoutRequest's atomic
        // transaction: a Technician (or an Admin, via "Request for Myself")
        // locks the asset with their OWN new pending request at the same
        // time the InventoryCheckoutRequests doc is created. Without this,
        // that write — and therefore the whole transaction, including the
        // request doc itself — was rejected for Technician, since the
        // clause above it is MainAdmin/Admin only. Narrowly scoped: only
        // sets pendingRequestId, and only from unset (null) to a value —
        // never clears it and never touches custody/status fields.
        (inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'] &&
          resource.data.pendingRequestId == null &&
          request.resource.data.pendingRequestId != null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pendingRequestId', 'updatedAt']))
      );

      // No delete — assets anchor their custody ledger; retire via status
      // update instead so history is never orphaned.
      allow delete: if false;
    }

    // Append-only custody ledger: checkout / return events.
    match /InventoryAssetAssignments/{assignmentId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician']
                     && request.resource.data.recordedByUid == request.auth.uid
                     && request.resource.data.recordedByRole == inventoryUserRole();

      // Hard requirement: nobody — not even MainAdmin — may ever edit or
      // delete a custody event once it's written.
      allow update: if false;
      allow delete: if false;
    }

    // ── InventoryAssetBookings: scheduled checkout/return windows ─────────
    // MainAdmin/Admin book directly, or a Technician's approved request
    // turns into one (createdByUid is always the actioning admin in both
    // cases — see InventoryService.createBooking/approveCheckoutRequest).
    // An Admin can never book an asset out to themself — MainAdmin is
    // exempt (has unlimited access); enforced here as the authoritative
    // check (InventoryService's client-side guard is UX only).
    match /InventoryAssetBookings/{bookingId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin']
                     && request.resource.data.createdByUid == request.auth.uid
                     && !(inventoryUserRole() == 'Admin' &&
                          request.resource.data.bookedForUid == request.auth.uid);

      // (a) Collection: scheduled -> active, stamping the checkout ledger link
      //     (plus dispatch-by-driver fields, when this booking's delivery is
      //     via a Driver/Transporter rather than a direct handoff).
      // (b) Return: active -> completed, stamping the return ledger link.
      // (c) Cancellation: scheduled -> cancelled.
      // (d) Delivery acknowledgment: only the booking's own bookedForUid,
      //     only when deliveryMethod is 'driver', and only those fields
      //     — never condition/photos, so a holder can never self-assess
      //     their own item's condition (see InventoryService.acknowledgeDelivery).
      //     handoverFormScanUrl is optional supporting evidence (the scanned
      //     signed paper form) uploaded alongside the same real ack.
      allow update: if request.auth != null && (
        (inventoryUserRole() in ['MainAdmin', 'Admin'] && (
          (resource.data.status == 'scheduled' && request.resource.data.status == 'active' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'checkoutAssignmentId', 'dispatchedAt', 'dispatchedByUid', 'dispatchedByName']))
          ||
          (resource.data.status == 'active' && request.resource.data.status == 'completed' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnAssignmentId']))
          ||
          (resource.data.status == 'scheduled' && request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledByUid', 'cancelledByName', 'cancelledAt', 'cancellationReason']))
        ))
        ||
        (resource.data.bookedForUid == request.auth.uid
          && resource.data.deliveryMethod == 'driver'
          && request.resource.data.deliveryAcknowledgedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deliveryAcknowledgedAt', 'deliveryAcknowledgedByUid', 'handoverFormScanUrl']))
      );

      allow delete: if false;
    }

    // ── InventoryAssetMaintenanceWindows: MainAdmin/Admin blackout dates ──
    // Plain scheduling data, not an audit ledger — may be cancelled outright.
    match /InventoryAssetMaintenanceWindows/{windowId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin']
                     && request.resource.data.createdByUid == request.auth.uid;

      allow update: if false;

      allow delete: if request.auth != null && inventoryUserRole() in ['MainAdmin', 'Admin'];
    }

    // ── InventoryMaterials — same shape/permissions as InventoryAssets ────
    match /InventoryMaterials/{materialId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin']
                     && request.resource.data.createdByUid == request.auth.uid;

      // (a) MainAdmin/Admin correcting descriptive fields.
      // (b) MainAdmin/Admin's receipt/issue transaction updating only the
      //     running quantity balance (paired with a new, immutable
      //     InventoryMaterialMovements doc in the same transaction).
      allow update: if request.auth != null && (
        (inventoryUserRole() in ['MainAdmin', 'Admin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'category', 'unit', 'source', 'description',
                      'photoUrl', 'reorderLevel', 'updatedAt']))
        ||
        (inventoryUserRole() in ['MainAdmin', 'Admin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantityInStorage', 'updatedAt']))
      );

      allow delete: if false;
    }

    // Append-only stock ledger: receipt / issue events.
    match /InventoryMaterialMovements/{movementId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician']
                     && request.resource.data.recordedByUid == request.auth.uid
                     && request.resource.data.recordedByRole == inventoryUserRole();

      allow update: if false;
      allow delete: if false;
    }

    // ── InventoryMaterialFabricationOrders: paper-form chain of custody ───
    // Decided per issue, not a fixed material property. The Driver and
    // Fabricator legs have no app account (by design — see
    // InventoryService's fabrication-order doc comment) and travel on a
    // printed form instead; only the Technician's final scan-upload is a
    // digital write, and it's a single atomic transition (issued ->
    // verified/discrepancy) carrying every human-reviewed field from that
    // upload — never partial, never from anyone but the technician who
    // actually performed it.
    match /InventoryMaterialFabricationOrders/{orderId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin']
                     && request.resource.data.issuedByUid == request.auth.uid
                     && request.resource.data.status == 'issued';

      allow update: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician']
                     && resource.data.status == 'issued'
                     && request.resource.data.status in ['verified', 'discrepancy']
                     && request.resource.data.technicianAckByUid == request.auth.uid
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'scannedFormUrl', 'ocrRawText', 'ocrExtractedFields',
                                    'driverAckQuantityAtPickup', 'fabricatorName',
                                    'fabricatorAckQuantityReceived', 'fabricatorAckCondition',
                                    'fabricatorDamageNotes', 'fabricatorAckQuantityOutput',
                                    'driverAckQuantityFromFabricator', 'technicianAckQuantityReceived',
                                    'technicianAckByUid', 'technicianAckByName', 'technicianAckAt',
                                    'verifiedByUid', 'verifiedByName', 'verifiedAt']);

      allow delete: if false;
    }

    // ── InventoryCheckoutRequests: Technician requests, MainAdmin/Admin
    // approve/reject ──────────────────────────────────────────────────────
    // A request starts 'pending' and can only ever move to 'approved' or
    // 'rejected' — never back, and never edited further after that. The
    // same self-checkout guard as InventoryAssetBookings applies: an Admin
    // can't approve a request onto themself (MainAdmin exempt) — though in
    // practice only Technician still uses this flow.
    match /InventoryCheckoutRequests/{requestId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'Technician']
                     && request.resource.data.requestedByUid == request.auth.uid
                     && request.resource.data.status == 'pending';

      allow update: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin']
                     && resource.data.status == 'pending'
                     && request.resource.data.status in ['approved', 'rejected']
                     && !(inventoryUserRole() == 'Admin' &&
                          request.auth.uid == resource.data.requestedByUid)
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'respondedByUid', 'respondedByName',
                                    'respondedAt', 'rejectionReason']);

      allow delete: if false;
    }
  }
}
