rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: the previous blanket `match /{document=**} { allow read, write: if
    // true; }` catch-all has been removed. Firestore evaluates all matching
    // rule blocks for a path as an OR, so as long as that catch-all existed,
    // no other rule in this file — including the strict InventoryAssets /
    // InventoryAssetAssignments rules below — could ever actually restrict
    // anything. Every collection the app uses now has its own explicit block
    // below (audited against the full lib/ source tree), so removing the
    // catch-all is a no-op for every existing feature and is required for
    // the new Inventory rules to mean anything.

    // Rules for Projects collection
    match /Projects/{projectId} {
      allow read, write: if true;
      
      // Allow access to subcollections
      match /tasks/{taskId} {
        allow read, write: if true;
      }
      
      match /activities/{activityId} {
        allow read, write: if true;
      }
      
      match /photos/{photoId} {
        allow read, write: if true;
      }
      
      match /Drawings/{drawingId} {
        allow read, write: if true;
      }
    }
    
    // Rules for Tasks collection
    match /Tasks/{taskId} {
      allow read, write: if true;
    }
    
    // Rules for Users collection. Read/create/delete are left exactly as
    // they were (wide open) — this only tightens 'update', and only for
    // the specific 'role'/'isProjectManager' fields, so every other write
    // path already using this collection (FCM token persistence, profile
    // edits, etc.) keeps working completely unchanged.
    //
    // Role-grant enforcement previously existed only in the Flutter UI
    // (client_access_requests_screen.dart's canGrantAdmin check) — nothing
    // stopped a caller bypassing the app UI from granting themselves any
    // role, including MainAdmin, directly against Firestore. This mirrors
    // that same UI-level scoping here as the real security boundary:
    // MainAdmin may grant anything; Admin may only move someone into
    // Technician or SubContractor and may never touch isProjectManager;
    // nobody may change a *currently* MainAdmin account's role at all
    // (immunity — matches the same guard in
    // ClientRequestService.updateGrantedRole/revokeProjectsFromApprovedRequest).
    match /Users/{userId} {
      allow read: if true;
      allow create, delete: if true;
      allow update: if request.auth != null && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isProjectManager'])
        || (
          // MainAdmin's own doc is immune to every caller below, including
          // another MainAdmin or a SystemAdmin — this clause alone is what
          // keeps that true regardless of which role gets added above.
          resource.data.role != 'MainAdmin'
          && (
            // SystemAdmin has the same unrestricted grant power as
            // MainAdmin here (per requirement) — the one exception is the
            // MainAdmin-immunity clause just above, which already applies
            // equally to both.
            inventoryUserRole() in ['MainAdmin', 'SystemAdmin']
            || (
              inventoryUserRole() == 'Admin'
              && request.resource.data.role in ['Technician', 'SubContractor']
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isProjectManager'])
            )
          )
        )
      );
    }
    
    // Rules for ClientRequests collection (NEW)
    match /ClientRequests/{requestId} {
      allow read, write: if true;
    }
    
    // Rules for ActivityItems collection
    match /ActivityItems/{activityId} {
      allow read, write: if true;
    }
    
    // Rules for Notifications collection
    match /Notifications/{notificationId} {
      allow read, write: if true;
    }
    
    // Rules for Reports collection
    match /Reports/{reportId} {
      allow read, write: if true;
    }
    
    // Rules for Settings collection
    match /Settings/{settingId} {
      allow read, write: if true;
    }
    
    // Rules for Attendance collection
    match /Attendance/{attendanceId} {
      allow read, write: if true;
    }
    
    // Rules for Weather collection
    match /Weather/{weatherId} {
      allow read, write: if true;
    }
    
    // Rules for Financial collection
    match /Financials/{financialId} {
      allow read, write: if true;
    }
    
    // Rules for Schedule collection
    match /Schedule/{scheduleId} {
      allow read, write: if true;
    }
    
    // Rules for Resources collection
    match /Resources/{resourceId} {
      allow read, write: if true;
    }
    
    match /ScheduleNotifications/{notificationId} {
      allow read, write: if true;
    }
    
    // Rules for QualitySafety collection
    match /QualitySafety/{qualitySafetyId} {
      allow read, write: if true;
    }
    
    // Rules for BidManagement collection
    match /BidManagement/{bidId} {
      allow read, write: if true;
    }
    
    // Rules for DesignCoordination collection
    match /DesignCoordination/{designId} {
      allow read, write: if true;
    }
    
    // Rules for FieldProductivity collection
    match /FieldProductivity/{productivityId} {
      allow read, write: if true;
    }
    
    // Rules for RecentSearches collection
    match /RecentSearches/{searchId} {
      allow read, write: if true;
    }
    
    // Rules for UserProfiles collection
    match /UserProfiles/{userId} {
      allow read, write: if true;
    }
    
    // Rules for SystemLogs collection
    match /SystemLogs/{logId} {
      allow read, write: if true;
    }
    
    // Rules for PurchaseplanResources collection
    match /PurchaseplanResources/{resourceId} {
      allow read, write: if true;
    }
    
    // Rules for PhotoGallery collection (top-level)
    match /PhotoGallery/{photoId} {
      allow read, write: if true;
    }
    
    // Rules for ProjectDocuments collection (top-level).
    // Client is view-only everywhere, including their own tab — only
    // Admin/Technician/SystemAdmin/MainAdmin may upload, edit, or delete.
    // documents_screen.dart pairs every create/delete here with an append-
    // only DocumentAuditLog entry (see below) for accountability.
    match /ProjectDocuments/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];
    }

    // Rules for QualityDocuments collection — same access model as
    // ProjectDocuments for consistency.
    match /QualityDocuments/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];
    }

    // Rules for SafetyDocuments collection — same access model as
    // ProjectDocuments for consistency.
    match /SafetyDocuments/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
        && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];
    }

    // Append-only accountability trail for the whole Documents section (all
    // main tabs and sub-tabs: Client/Sub-Contractor/Supplier/dynamic other-
    // role, Contract/Communication/Access Requests). A caller can't forge
    // who they claim to be — actorUid/actorRole are cross-checked against
    // the caller's own auth uid and their UserRoles/{uid} mirror.
    match /DocumentAuditLog/{entryId} {
      allow read: if request.auth != null
        && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow create: if request.auth != null
        && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician']
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == inventoryUserRole();

      allow update: if false;
      allow delete: if false;
    }

    // Rules for Drawings collection
    match /Drawings/{drawingId} {
      allow read, write: if true;
    }
    
    // Rules for GeneralSchedules collection (NEW)
    match /GeneralSchedules/{scheduleId} {
      allow read, write: if true;
    }

    // ── Collections discovered in use but previously relying solely on the
    // top-level catch-all (audited prior to its removal, see below) ────────
    match /AdminNotificationQueue/{itemId} {
      allow read, write: if true;
    }

    // Targeted counterpart to AdminNotificationQueue (see
    // lib/rbacsystem/notification_service.dart's setupUserNotificationListener
    // and lib/services/inventory_service.dart's _notifyUser) — same
    // permissiveness as AdminNotificationQueue for consistency.
    match /UserNotificationQueue/{itemId} {
      allow read, write: if true;
    }

    // Messages are readable/writable only by their participants (sender +
    // To + Cc), tracked via the flat `participantUids` array kept in sync
    // with `from`/`to`/`cc` at send time (see CommunicationMessage in
    // communication_models.dart — rules can't reach into map fields nested
    // inside an array element, hence the separate flat uid list). Only
    // `readByUids`/`deletedByUids` may be mutated post-send (mark read/
    // unread, soft delete/restore) — everything else about a sent message
    // is immutable, and messages are never hard-deleted (soft delete only).
    match /Communication/{messageId} {
      allow read: if request.auth != null
                   && request.auth.uid in resource.data.participantUids;

      allow create: if request.auth != null
                     && request.resource.data.from.uid == request.auth.uid
                     && request.auth.uid in request.resource.data.participantUids;

      allow update: if request.auth != null
                     && request.auth.uid in resource.data.participantUids
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['readByUids', 'deletedByUids']);

      allow delete: if false;
    }

    // Drafts are private to the user who saved them.
    match /CommunicationDrafts/{draftId} {
      allow read, update, delete: if request.auth != null
                     && request.auth.uid == resource.data.ownerUid;

      allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.ownerUid;
    }

    match /ScheduleMonitor/{docId} {
      allow read, write: if true;
    }

    // One doc per project (docId == project id) holding the full task-progress
    // grid (rows + daily status ticks). Read stays open to the same roles the
    // "Task Progress" sidebar item is shown to in base_layout.dart (everyone
    // except Client) so non-admin roles can still view it. Write is narrower
    // than that: editing task dates/marking status is Admin/MainAdmin only,
    // except that the project's own linked Project Manager (see
    // Projects/{docId}.projectManagerUid — docId here IS the project id) may
    // also write, purely so they can apply their own approved
    // ProjectDateExtensionRequests (shifting phase/project-title rows whose
    // date matched the old project boundary) even when their account role
    // isn't Admin/MainAdmin.
    match /TaskProgressMonitor/{docId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow write: if request.auth != null && (
        inventoryUserRole() in ['MainAdmin', 'Admin']
        || (
          // Scoped narrowly to exactly the {rows, updatedAt} shape
          // _saveToFirestore sends — the same write path used to apply an
          // approved project extension's phase-row shifts. A non-Admin/
          // MainAdmin PM still can't touch dailyStatuses (that's a
          // different write path, dotted 'dailyStatuses.$key' keys via
          // _flushDirtyStatuses) — day-status marking stays Admin/MainAdmin
          // only, no PM exception.
          get(/databases/$(database)/documents/Projects/$(docId)).data.projectManagerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rows', 'updatedAt'])
        )
      );
    }

    // Project date-extension requests: an Admin/MainAdmin proposes new
    // start/end dates for the *project itself* (Projects/{projectId}) —
    // the single top-level approval gate task dates are checked against
    // (see TaskProgressMonitor's write rule below and
    // task_progress_monitor_screen.dart's _onTaskDateTap). Read stays as
    // open as TaskProgressMonitor itself. Only the project's linked PM or
    // a MainAdmin may resolve (approve/reject) a pending request, and only
    // the response fields — never the original request's own data.
    match /ProjectDateExtensionRequests/{requestId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin']
                     && request.resource.data.requestedByUid == request.auth.uid
                     && request.resource.data.status == 'pending';

      allow update: if request.auth != null
                     && (inventoryUserRole() == 'MainAdmin'
                         || request.auth.uid == resource.data.projectManagerUid)
                     && resource.data.status == 'pending'
                     && request.resource.data.status in ['approved', 'rejected']
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'respondedByUid', 'respondedByName',
                                    'respondedAt', 'rejectionReason']);

      allow delete: if false;
    }

    match /ClientAccessRequests/{requestId} {
      allow read, write: if true;
    }

    match /Photos/{photoId} {
      allow read, write: if true;
    }

    match /NotificationLocks/{lockId} {
      allow read, write: if true;
    }

    // Lowercase 'projects' — distinct from the capitalized 'Projects'
    // collection above; used by financial_screen.dart, documents_screen.dart,
    // and rbacsystem/client_request_service.dart.
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // ═══════════════════════════════════════════════════════════════════
    // INVENTORY MODULE (Phase 1: Assets + custody traceability)
    // These are the only collections in this file with real, enforced
    // role checks — everything above stays wide open to match the rest
    // of the (pre-auth, dev-mode) app.
    // ═══════════════════════════════════════════════════════════════════

    // uid -> role mirror. Users/{username} docs are keyed by username, not
    // uid, so rules can't get() a caller's role directly from Users; this
    // collection exists purely so inventoryUserRole() below can resolve it
    // with a single-document get().
    //
    // Self-healing sync, not a one-time write: the doc must carry a
    // 'username' field naming the caller's own Users/{username} doc, and the
    // write is only accepted if that Users doc's `uid` matches the caller AND
    // its `role` matches the value being written. A caller can therefore
    // never write a role they don't already hold in Users — they can only
    // mirror truth that already exists there, into a shape rules can look up
    // by uid. AuthService.ensureUserRoleMirror() calls this on every login
    // and at registration, so any account — new or pre-existing — self-heals
    // its mirror automatically the next time it signs in; no manual Admin SDK
    // backfill is required for accounts to stop being gated out of Inventory.
    function _usersDocForRoleMirror() {
      return get(/databases/$(database)/documents/Users/$(request.resource.data.username));
    }

    match /UserRoles/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
                             && request.auth.uid == uid
                             && request.resource.data.keys().hasOnly(['role', 'username'])
                             && _usersDocForRoleMirror().data.uid == request.auth.uid
                             && _usersDocForRoleMirror().data.role == request.resource.data.role;

      allow delete: if false;
    }

    function inventoryUserRole() {
      return get(/databases/$(database)/documents/UserRoles/$(request.auth.uid)).data.role;
    }

    match /InventoryAssets/{assetId} {
      // Technician/Admin read + request checkouts same as MainAdmin/SystemAdmin,
      // but never register new items and never perform the custody-pointer
      // update directly (see the `update` block below) — that's
      // MainAdmin/SystemAdmin only, via the approval transaction.
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      // MainAdmin/Admin/SystemAdmin may register new assets — Admin keeps
      // this one catalog power even though it lost edit/approve/return.
      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin']
                     && request.resource.data.createdByUid == request.auth.uid;

      // Five distinct, narrowly-scoped update paths:
      //  (a) MainAdmin-only: correcting descriptive fields.
      //  (b) MainAdmin/SystemAdmin's checkout/return transaction updating
      //      only the custody-pointer fields (paired with a new, immutable
      //      InventoryAssetAssignments doc in the same transaction) —
      //      includes clearing returnRequestedAt on return.
      //  (c) MainAdmin/SystemAdmin's booking mutation refreshing the
      //      denormalized "next upcoming booking" pointer
      //      (InventoryService._refreshNextBooking).
      //  (d) anyone requesting locks the asset with their OWN new pending
      //      request (see below).
      //  (e) the current holder — any role — signals return intent
      //      (InventoryService.notifyReturnIntent), only from unset to set.
      allow update: if request.auth != null && (
        (inventoryUserRole() == 'MainAdmin' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'category', 'description', 'serialNumber', 'photoUrl', 'updatedAt']))
        ||
        (inventoryUserRole() in ['MainAdmin', 'SystemAdmin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'currentHolderId', 'currentHolderName',
                      'currentProjectId', 'currentProjectName',
                      'currentAssignmentId', 'pendingRequestId', 'returnRequestedAt', 'updatedAt']))
        ||
        (inventoryUserRole() in ['MainAdmin', 'SystemAdmin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nextBookingId', 'nextBookingStart', 'nextBookingEnd', 'nextBookingByName']))
        ||
        // The other half of InventoryService.createCheckoutRequest's atomic
        // transaction: everyone now requests for themself (including
        // MainAdmin/SystemAdmin — nobody self-approves), locking the asset
        // with their OWN new pending request at the same time the
        // InventoryCheckoutRequests doc is created. Narrowly scoped: only
        // sets pendingRequestId, and only from unset (null) to a value —
        // never clears it and never touches custody/status fields.
        (inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'] &&
          resource.data.pendingRequestId == null &&
          request.resource.data.pendingRequestId != null &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['pendingRequestId', 'updatedAt']))
        ||
        (resource.data.currentHolderId == request.auth.uid &&
          resource.data.get('returnRequestedAt', null) == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnRequestedAt']))
      );

      // No delete — assets anchor their custody ledger; retire via status
      // update instead so history is never orphaned.
      allow delete: if false;
    }

    // Append-only custody ledger: checkout / return events. Only
    // MainAdmin/SystemAdmin ever write one now — approve/collect/return are
    // all MainAdmin/SystemAdmin actions; Technician/Admin only request.
    match /InventoryAssetAssignments/{assignmentId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'SystemAdmin']
                     && request.resource.data.recordedByUid == request.auth.uid
                     && request.resource.data.recordedByRole == inventoryUserRole();

      // Hard requirement: nobody — not even MainAdmin — may ever edit or
      // delete a custody event once it's written.
      allow update: if false;
      allow delete: if false;
    }

    // ── InventoryAssetBookings: scheduled checkout/return windows ─────────
    // Only ever created by MainAdmin/SystemAdmin approving a checkout
    // request (createdByUid is always the approving admin — see
    // InventoryService.approveCheckoutRequest). Nobody — not even
    // MainAdmin — may create a booking naming themself as the recipient;
    // a different MainAdmin/SystemAdmin must always process it (enforced
    // here as the authoritative check; InventoryService's
    // _assertNotSelfAssignment is UX-only).
    match /InventoryAssetBookings/{bookingId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'SystemAdmin']
                     && request.resource.data.createdByUid == request.auth.uid
                     && request.resource.data.bookedForUid != request.auth.uid;

      // (a) Collection: scheduled -> active, stamping the checkout ledger link
      //     (plus dispatch-by-driver fields, when this booking's delivery is
      //     via a Driver/Transporter rather than a direct handoff).
      // (b) Return: active -> completed, stamping the return ledger link.
      // (c) Cancellation: scheduled -> cancelled (includes maintenance-
      //     priority auto-cancellation — see InventoryService.createMaintenanceWindow).
      // (d) Delivery acknowledgment: only the booking's own bookedForUid,
      //     only when deliveryMethod is 'driver', and only those fields
      //     — never condition/photos, so a holder can never self-assess
      //     their own item's condition (see InventoryService.acknowledgeDelivery).
      //     handoverFormScanUrl is optional supporting evidence (the scanned
      //     signed paper form) uploaded alongside the same real ack.
      allow update: if request.auth != null && (
        (inventoryUserRole() in ['MainAdmin', 'SystemAdmin'] && (
          (resource.data.status == 'scheduled' && request.resource.data.status == 'active' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'checkoutAssignmentId', 'dispatchedAt', 'dispatchedByUid', 'dispatchedByName']))
          ||
          (resource.data.status == 'active' && request.resource.data.status == 'completed' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnAssignmentId']))
          ||
          (resource.data.status == 'scheduled' && request.resource.data.status == 'cancelled' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledByUid', 'cancelledByName', 'cancelledAt', 'cancellationReason']))
        ))
        ||
        (resource.data.bookedForUid == request.auth.uid
          && resource.data.deliveryMethod == 'driver'
          && request.resource.data.deliveryAcknowledgedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deliveryAcknowledgedAt', 'deliveryAcknowledgedByUid', 'handoverFormScanUrl']))
      );

      allow delete: if false;
    }

    // ── InventoryAssetMaintenanceWindows: MainAdmin-only blackout dates ───
    // Plain scheduling data, not an audit ledger — may be cancelled outright.
    // MainAdmin is the only role that may schedule or cancel maintenance.
    match /InventoryAssetMaintenanceWindows/{windowId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() == 'MainAdmin'
                     && request.resource.data.createdByUid == request.auth.uid;

      allow update: if false;

      allow delete: if request.auth != null && inventoryUserRole() == 'MainAdmin';
    }

    // ── InventoryMaterials — same shape/permissions as InventoryAssets ────
    match /InventoryMaterials/{materialId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      // MainAdmin/Admin/SystemAdmin may register new materials — Admin
      // keeps this one catalog power even though it lost edit/issue.
      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin']
                     && request.resource.data.createdByUid == request.auth.uid;

      // (a) MainAdmin-only: correcting descriptive fields.
      // (b) MainAdmin/SystemAdmin's receipt/issue transaction updating only
      //     the running quantity balance (paired with a new, immutable
      //     InventoryMaterialMovements doc in the same transaction).
      allow update: if request.auth != null && (
        (inventoryUserRole() == 'MainAdmin' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'category', 'unit', 'source', 'description',
                      'photoUrl', 'reorderLevel', 'updatedAt']))
        ||
        (inventoryUserRole() in ['MainAdmin', 'SystemAdmin'] &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['quantityInStorage', 'updatedAt']))
      );

      allow delete: if false;
    }

    // Append-only stock ledger: receipt / issue events.
    match /InventoryMaterialMovements/{movementId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician']
                     && request.resource.data.recordedByUid == request.auth.uid
                     && request.resource.data.recordedByRole == inventoryUserRole();

      allow update: if false;
      allow delete: if false;
    }

    // ── InventoryMaterialFabricationOrders: paper-form chain of custody ───
    // Decided per issue, not a fixed material property. The Driver and
    // Fabricator legs have no app account (by design — see
    // InventoryService's fabrication-order doc comment) and travel on a
    // printed form instead. Three separate, field-restricted update
    // clauses below for the three-step Admin-then-SystemAdmin review chain:
    // (a) the site recipient's scan submission (issued -> pendingAdminReview
    //     if Technician, or issued -> scanUploaded if Admin/MainAdmin —
    //     never self-verifies), (b) an Admin/MainAdmin's review
    //     (pendingAdminReview -> scanUploaded), (c) a SystemAdmin/MainAdmin's
    //     final verify/discrepancy call (scanUploaded -> verified/discrepancy).
    match /InventoryMaterialFabricationOrders/{orderId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      // Issuing material for fabrication is a canApproveAndIssue action —
      // MainAdmin/SystemAdmin only.
      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'SystemAdmin']
                     && request.resource.data.issuedByUid == request.auth.uid
                     && request.resource.data.status == 'issued';

      allow update: if request.auth != null && (
        // (a) Site recipient's scan submission.
        (inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician']
          && resource.data.status == 'issued'
          && request.resource.data.status in ['pendingAdminReview', 'scanUploaded']
          && request.resource.data.technicianAckByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'scannedFormUrl', 'ocrRawText', 'ocrExtractedFields',
                         'driverAckQuantityAtPickup', 'fabricatorName',
                         'fabricatorAckQuantityReceived', 'fabricatorAckCondition',
                         'fabricatorDamageNotes', 'fabricatorAckQuantityOutput',
                         'driverAckQuantityFromFabricator', 'technicianAckQuantityReceived',
                         'technicianAckByUid', 'technicianAckByName', 'technicianAckAt',
                         'hasQuantityDiscrepancy']))
        ||
        // (b) Admin/MainAdmin review.
        (inventoryUserRole() in ['Admin', 'MainAdmin']
          && resource.data.status == 'pendingAdminReview'
          && request.resource.data.status == 'scanUploaded'
          && request.resource.data.adminReviewedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'adminReviewedByUid', 'adminReviewedByName', 'adminReviewedAt']))
        ||
        // (c) SystemAdmin/MainAdmin final verify/discrepancy.
        (inventoryUserRole() in ['SystemAdmin', 'MainAdmin']
          && resource.data.status == 'scanUploaded'
          && request.resource.data.status in ['verified', 'discrepancy']
          && request.resource.data.verifiedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'verifiedByUid', 'verifiedByName', 'verifiedAt']))
      );

      allow delete: if false;
    }

    // ── InventoryCheckoutRequests: everyone requests, MainAdmin/SystemAdmin
    // approve/reject ──────────────────────────────────────────────────────
    // A request starts 'pending' and can only ever move to 'approved' or
    // 'rejected' — never back, and never edited further after that. Nobody
    // — not even MainAdmin — may approve/reject their own request; a
    // different MainAdmin/SystemAdmin must always process it.
    match /InventoryCheckoutRequests/{requestId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician']
                     && request.resource.data.requestedByUid == request.auth.uid
                     && request.resource.data.status == 'pending';

      allow update: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'SystemAdmin']
                     && resource.data.status == 'pending'
                     && request.resource.data.status in ['approved', 'rejected']
                     && request.auth.uid != resource.data.requestedByUid
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'respondedByUid', 'respondedByName',
                                    'respondedAt', 'rejectionReason']);

      allow delete: if false;
    }

    // ── Safety Training: gamified worker safety-awareness module ─────────
    // Content (scenarios) is admin-authored; results (sessions) are an
    // append-only per-worker ledger, same shape as the Inventory custody
    // ledger above — reuses inventoryUserRole() since it's the same
    // UserRoles/{uid} mirror, not an Inventory-specific concept.
    function isSafetyContentAdmin() {
      return request.auth != null
             && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin'];
    }

    function safetyAnswerKeyPath(scenarioId) {
      return /databases/$(database)/documents/SafetyTrainingAnswerKeys/$(scenarioId);
    }

    // Shape every written scenario must have. The answer (correctOptionIndex)
    // and its explanation must NOT live on the scenario doc — Technicians
    // can read scenarios, so they live in SafetyTrainingAnswerKeys instead.
    function isValidSafetyScenario(d) {
      return d.title is string && d.title.size() > 0
             && d.question is string && d.question.size() > 0
             && d.options is list && d.options.size() >= 2 && d.options.size() <= 4
             && d.points is int && d.points > 0 && d.points <= 1000
             && d.isActive is bool
             && !d.keys().hasAny(['correctOptionIndex', 'explanation']);
    }

    match /SafetyTrainingScenarios/{scenarioId} {
      allow read: if request.auth != null
                   && inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin', 'Technician'];

      // create: the authoring admin must self-attest as createdByUid, and
      // the scenario's answer key must be written in the same batch.
      // update: any admin role may edit content or toggle isActive —
      // scenario authorship doesn't restrict who can maintain it, but the
      // authorship fields themselves are immutable, and changing the
      // options requires the (post-batch) answer key to still be in range.
      allow create: if isSafetyContentAdmin()
                     && request.resource.data.createdByUid == request.auth.uid
                     && isValidSafetyScenario(request.resource.data)
                     && existsAfter(safetyAnswerKeyPath(scenarioId));

      allow update: if isSafetyContentAdmin()
                     && isValidSafetyScenario(request.resource.data)
                     && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['createdByUid', 'createdByName', 'createdByRole', 'createdAt'])
                     && (!('options' in request.resource.data.diff(resource.data).affectedKeys())
                         || getAfter(safetyAnswerKeyPath(scenarioId)).data.correctOptionIndex
                              < request.resource.data.options.size());

      allow delete: if false;
    }

    // The graded part of a scenario — read only by admins (authoring/edit)
    // and by the submitSafetyScenarioAttempt Cloud Function (Admin SDK).
    // The index is checked against the scenario's options as they'll be
    // once the surrounding batch commits.
    match /SafetyTrainingAnswerKeys/{scenarioId} {
      allow read: if isSafetyContentAdmin();

      allow create, update: if isSafetyContentAdmin()
                             && request.resource.data.correctOptionIndex is int
                             && request.resource.data.correctOptionIndex >= 0
                             && request.resource.data.correctOptionIndex
                                  < getAfter(/databases/$(database)/documents/SafetyTrainingScenarios/$(scenarioId)).data.options.size()
                             && request.resource.data.explanation is string;

      allow delete: if false;
    }

    // Append-only: a worker's completed attempt, once recorded, is never
    // edited or deleted — including by the worker themself — so a
    // trainer's view of past reasoning answers can't be altered after the
    // fact. Created only by the submitSafetyScenarioAttempt Cloud Function,
    // which grades the answer server-side — a client-written session could
    // claim any isCorrect/pointsEarned it liked.
    match /SafetyTrainingSessions/{sessionId} {
      // `resource == null`: the app watches the session doc for an attempt
      // it's submitting (it generates the id up front) before the grading
      // function has written it — reading a not-yet-existing doc reveals
      // nothing.
      allow read: if request.auth != null
                   && (resource == null
                       || resource.data.workerUid == request.auth.uid
                       || inventoryUserRole() in ['MainAdmin', 'Admin', 'SystemAdmin']);

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // A MainAdmin/SystemAdmin's determination of a worker's overall safety-
    // training standing (cleared / needs retraining / escalated), based on
    // their accumulated SafetyTrainingSessions — append-only ledger, same
    // shape as SafetyTrainingSessions above. Deliberately scoped to just
    // MainAdmin/SystemAdmin (excluding plain Admin, unlike most other
    // admin-tier gates in this file) since this is the designated reviewer
    // tier for the safety-training program. A worker may read their own
    // review history so they can see their current standing.
    match /SafetyTrainingReviews/{reviewId} {
      allow read: if request.auth != null
                   && (resource.data.workerUid == request.auth.uid
                       || inventoryUserRole() in ['MainAdmin', 'SystemAdmin']);

      // A reviewer can't record a determination about themselves — their
      // own standing is for another MainAdmin/SystemAdmin to decide.
      allow create: if request.auth != null
                     && inventoryUserRole() in ['MainAdmin', 'SystemAdmin']
                     && request.resource.data.reviewedByUid == request.auth.uid
                     && request.resource.data.workerUid is string
                     && request.resource.data.workerUid.size() > 0
                     && request.resource.data.workerUid != request.auth.uid
                     && request.resource.data.status in ['cleared', 'needsRetraining', 'escalated']
                     && request.resource.data.notes is string
                     && request.resource.data.notes.size() <= 2000
                     && request.resource.data.reviewedAt is timestamp
                     && isValidSafetyReviewOutcome(request.resource.data);

      allow update: if false;
      allow delete: if false;
    }

    // What each status must carry so it has a consequence the app and the
    // daily follow-up Cloud Function can act on:
    //   cleared         → when the clearance lapses (expiresAt)
    //   needsRetraining → which scenarios to redo, and by when
    //   escalated       → which MainAdmin/SystemAdmin it's escalated to
    function isValidSafetyReviewOutcome(d) {
      return (d.status != 'cleared'
              || (d.expiresAt is timestamp && d.expiresAt > d.reviewedAt))
             && (d.status != 'needsRetraining'
                 || (d.assignedScenarioIds is list
                     && d.assignedScenarioIds.size() >= 1
                     && d.assignedScenarioIds.size() <= 50
                     && d.dueAt is timestamp
                     && d.dueAt > d.reviewedAt))
             && (d.status != 'escalated'
                 || (d.escalatedToUid is string
                     && d.escalatedToUid != d.workerUid
                     && d.escalatedToUid != request.auth.uid
                     && get(/databases/$(database)/documents/UserRoles/$(d.escalatedToUid)).data.role
                          in ['MainAdmin', 'SystemAdmin']));
    }

    // Per-worker training aggregates (first-attempt scoring, last attempt
    // per scenario), maintained only by the submitSafetyScenarioAttempt /
    // rebuildSafetyTrainingStats Cloud Functions.
    match /SafetyTrainingWorkerStats/{workerUid} {
      allow read: if request.auth != null
                   && (workerUid == request.auth.uid || isSafetyContentAdmin());
      allow write: if false;
    }

    // Bookkeeping for the stats rebuild (SafetyTrainingMeta/stats).
    match /SafetyTrainingMeta/{docId} {
      allow read: if isSafetyContentAdmin();
      allow write: if false;
    }

    // A trainer's comment on one recorded attempt — append-only, like the
    // sessions it annotates. Any admin-tier trainer may comment, except on
    // their own attempts; workerUid must match the session's, since it's
    // what scopes the worker's read access.
    match /SafetyTrainingFeedback/{feedbackId} {
      allow read: if request.auth != null
                   && (resource.data.workerUid == request.auth.uid || isSafetyContentAdmin());

      allow create: if isSafetyContentAdmin()
                     && request.resource.data.byUid == request.auth.uid
                     && request.resource.data.comment is string
                     && request.resource.data.comment.size() > 0
                     && request.resource.data.comment.size() <= 1000
                     && request.resource.data.sessionId is string
                     && request.resource.data.workerUid != request.auth.uid
                     && get(/databases/$(database)/documents/SafetyTrainingSessions/$(request.resource.data.sessionId)).data.workerUid
                          == request.resource.data.workerUid;

      allow update: if false;
      allow delete: if false;
    }
  }
}
